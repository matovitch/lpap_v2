# Copy to secrets.toml (gitignored) and fill. scripts/molab/inject-secrets.sh
# exports these into the paired molab kernel environment (never to disk there).
[huggingface]
token = ""   # write token → HF_TOKEN (run artifacts repo)

[pushover]
token = ""   # application token → PUSHOVER_TOKEN
user = ""    # user key → PUSHOVER_USER
